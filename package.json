{
  "name": "@addon-lab/plugin-paywall",
  "version": "0.0.1",
  "description": "React Paywall for Addon Bone",
  "keywords": [
    "adnbn",
    "paywall",
    "plugin"
  ],
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/atldays/addon-pay-react-paywall.git"
  },
  "homepage": "https://github.com/atldays/addon-pay-react-paywall#readme",
  "bugs": {
    "url": "https://github.com/atldays/addon-pay-react-paywall/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "files": [
    "plugin",
    "dist-types"
  ],
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./plugin/index.ts"
    },
    "./react": {
      "types": "./dist-types/provider/index.d.ts",
      "default": "./plugin/provider/index.ts"
    },
    "./page": {
      "types": "./dist-types/page.d.ts",
      "default": "./plugin/page.tsx"
    },
    "./locales/*": "./plugin/locales/*.yml"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint",
    "commitlint:branch": "commitlint --from origin/main --to HEAD --verbose",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run --ci",
    "prepublishOnly": "npm run build:types"
  },
  "dependencies": {
    "@addon-core/browser": "^0.7.2",
    "@addon-core/storage": "^0.7.0",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.4.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/lodash": "^4.14.175",
    "@types/react": "^19.0",
    "@types/react-dom": "^19.0",
    "addon-ui": "^0.11.0",
    "adnbn": "^0.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.5.3",
    "release-it": "^21.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "addon-ui": ">=0.11.0",
    "adnbn": ">=0.7.0",
    "react": "^16.8 || ^17.0 || ^18.0 || ^19.0 || ^19.0.0-rc",
    "react-dom": "^16.8 || ^17.0 || ^18.0 || ^19.0 || ^19.0.0-rc"
  },
  "allowScripts": {
    "adnbn@0.10.0": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
